@misc{bajari_multiple_2021,
	title = {Multiple Randomization Designs},
	url = {http://arxiv.org/abs/2112.13495},
	abstract = {In this study we introduce a new class of experimental designs. In a classical randomized controlled trial ({RCT}), or A/B test, a randomly selected subset of a population of units (e.g., individuals, plots of land, or experiences) is assigned to a treatment (treatment A), and the remainder of the population is assigned to the control treatment (treatment B). The diﬀerence in average outcome by treatment group is an estimate of the average eﬀect of the treatment. However, motivating our study, the setting for modern experiments is often diﬀerent, with the outcomes and treatment assignments indexed by multiple populations. For example, outcomes may be indexed by buyers and sellers, by content creators and subscribers, by drivers and riders, or by travelers and airlines and travel agents, with treatments potentially varying across these indices. Spillovers or interference can arise from interactions between units across populations. For example, sellers’ behavior may depend on buyers’ treatment assignment, or vice versa. This can invalidate the simple comparison of means as an estimator for the average eﬀect of the treatment in classical {RCTs}. We propose new experiment designs for settings in which multiple populations interact. We show how these designs allow us to study questions about interference that cannot be answered by classical randomized experiments. Finally, we develop new statistical methods for analyzing these Multiple Randomization Designs.},
	number = {{arXiv}:2112.13495},
	publisher = {{arXiv}},
	author = {Bajari, Patrick and Burdick, Brian and Imbens, Guido W. and Masoero, Lorenzo and {McQueen}, James and Richardson, Thomas and Rosen, Ido M.},
	urldate = {2024-09-03},
	date = {2021-12-26},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {2112.13495 [cs, econ, math, stat]},
	keywords = {Computer Science - Social and Information Networks, 62B15 (Primary) 91B82, 91B26, 91C20, 91B80, 91C20 (Secondary), Economics - Econometrics, G.3, I.2.6, J.4, Mathematics - Statistics Theory, Statistics - Methodology},
	file = {Bajari et al. - 2021 - Multiple Randomization Designs.pdf:/Users/nicolasroever/Zotero/storage/PJQ8CG5W/Bajari et al. - 2021 - Multiple Randomization Designs.pdf:application/pdf},
}

@article{cramton_dynamic_1991,
	title = {Dynamic Bargaining with Transaction Costs},
	volume = {37},
	issn = {0025-1909, 1526-5501},
	url = {https://pubsonline.informs.org/doi/10.1287/mnsc.37.10.1221},
	doi = {10.1287/mnsc.37.10.1221},
	abstract = {A buyer and seller alternate making offers until an offer is accepted or someone terminates negotiations. The seller's valuation is common knowledge, but the buyer's valuation is known only by the buyer. Impatience to reach an agreement comes from two sources: the traders discount future payoffs and there are transaction costs of bargaining. Equilibrium behavior involves either immediate trade, delayed trade, or immediate termination, depending on the size of the gains from trade and the relative bargaining costs. This contrasts with the pure discounting model where termination never occurs, and the pure transaction cost model where delayed trade never occurs.},
	pages = {1221--1233},
	number = {10},
	journaltitle = {Management Science},
	journal = {Management Science},
	author = {Cramton, Peter C.},
	urldate = {2025-06-03},
